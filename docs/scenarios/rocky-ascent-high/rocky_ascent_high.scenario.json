      "type": "sprite",
      "placeholderSourceId": "spring_goat_ram",
      "sourceSelection": "Use frame 5 from goat or ram_strip5.png.",
      "runtimeNotes": "Transparent finish pose."
    },
    {
      "id": "prop_rocky_ascent_high_step",
      "slot": "waypointVisuals[]",
      "type": "sprite",
      "placeholderSourceId": "karsiori_rock_piles",
      "sourceSelection": "Use one small/medium rock pile and duplicate it across authored waypoints.",
      "runtimeNotes": "Vary transform only."
    },
    {
      "id": "prop_rocky_ascent_high_goal",
      "slot": "destinationVisual",
      "type": "sprite",
      "placeholderSourceId": "karsiori_rock_piles",
      "sourceSelection": "Use a larger rock pile/cairn as the destination marker.",
      "runtimeNotes": "Persistent goal."
    },
    {
      "id": "fx_rocky_ascent_high_dust",
      "slot": "stepEffects[]",
      "type": "sprite",
      "placeholderSourceId": "spring_dust",
      "sourceSelection": "Use one readable static frame from dusty.gif.",
      "runtimeNotes": "Show briefly at hoof/rock contact."
    },
    {
      "id": "fx_rocky_ascent_high_tick",
      "slot": "stepEffects[]",
      "type": "sprite",
      "placeholderSourceId": "codemanu_pixel_fx",
      "sourceSelection": "Use one small impact/star/glint frame.",
      "runtimeNotes": "Scale in/out for Perfect feedback."
    }
  ],
