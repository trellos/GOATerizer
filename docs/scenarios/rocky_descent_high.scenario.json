{
  "$schema": "https://goaterizer.local/schema/scenario-v1.json",
  "id": "rocky_descent_high",
  "displayName": "Rocky Descent High",
  "theme": "GOATS",
  "minigameClass": "ClimbMinigame",
  "family": "Scale",
  "visualVerb": "CLIMB",
  "supportedLevels": [
    3,
    4,
    5,
    6
  ],
  "difficultyOffsetFromNormalVersion": 2,
  "normalVersion": "rocky_descent",
  "scenarioPremise": "The harder companion to Rocky Descent, on the same one-octave route. Where the normal version falls straight down the octave, this one sequences it in threes, so the goat steps back up for every three it comes down. Authored difficulty labels are two levels above the normal version: L3–6 instead of L1–4.",
  "runTransposition": {
    "promptRepresentation": "diatonic_scale_degree",
    "degreeVocabulary": [
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "b1"
    ],
    "transposeToRunKey": true,
    "nonDiatonicTargetsAllowed": false,
    "note": "One octave, root to root. `b1` is the octave root above `1`; there is no second band."
  },
  "classParameters": {
    "visualSpanMeasures": 4,
    "routeDirection": "descending",
    "poseCycle": [
      "goat_rocky_descent_high_advance_01",
      "goat_rocky_descent_high_advance_02",
      "goat_rocky_descent_high_advance_03",
      "goat_rocky_descent_high_advance_04"
    ],
    "badNotePolicy": "Wobble",
    "measurePauseMs": 0,
    "showDestinationFromStart": true,
    "goodNoteBehavior": [
      "increment successful progress",
      "advance descending to next authored waypoint",
      "cycle climber pose",
      "show fx_rocky_descent_high_dust at hoof/rock contact",
      "show fx_rocky_descent_high_tick for Perfect, optionally smaller for Good"
    ],
    "badNoteBehavior": [
      "do not advance waypoint",
      "briefly wobble active goat pose and return to same transform"
    ],
    "minigameCompleteBehavior": [
      "if passed, show goat_rocky_descent_high_finish at prop_rocky_descent_high_goal",
      "otherwise freeze at furthest earned waypoint"
    ]
  },
  "assetBindings": {
    "background": [
      "bg_rocky_descent_high"
    ],
    "climberPoses": [
      "goat_rocky_descent_high_advance_01",
      "goat_rocky_descent_high_advance_02",
      "goat_rocky_descent_high_advance_03",
      "goat_rocky_descent_high_advance_04"
    ],
    "finishPose": [
      "goat_rocky_descent_high_finish"
    ],
    "waypointVisuals": [
      "prop_rocky_descent_high_step"
    ],
    "destinationVisual": [
      "prop_rocky_descent_high_goal"
    ],
    "stepEffects": [
      "fx_rocky_descent_high_dust",
      "fx_rocky_descent_high_tick"
    ]
  },
  "assets": [
    {
      "id": "bg_rocky_descent_high",
      "slot": "background",
      "type": "background",
      "placeholderSourceId": "karsiori_mountains",
      "sourceSelection": "Reuse the same mountain/background source family; compose this version to feel higher on the mountain.",
