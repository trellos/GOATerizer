{
  "$schema": "https://goaterizer.local/schema/scenario-v1.json",
  "id": "rocky_descent",
  "displayName": "Rocky Descent",
  "theme": "GOATS",
  "minigameClass": "ClimbMinigame",
  "family": "Scale",
  "visualVerb": "CLIMB",
  "supportedLevels": [
    1,
    2,
    3,
    4
  ],
  "scenarioPremise": "A goat starts high on an alpine rock face and works its way downward one deliberate foothold at a time. The musical prompt mirrors Rocky Ascent in reverse: every scale fragment descends from the octave root b1 toward 1. Higher levels make the route steeper, tighter, faster, and more absurdly exposed.",
  "runTransposition": {
    "promptRepresentation": "diatonic_scale_degree",
    "degreeVocabulary": [
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "b1"
    ],
    "transposeToRunKey": true,
    "nonDiatonicTargetsAllowed": false,
    "note": "One octave, root to root. `b1` is the octave root above `1`; there is no second band."
  },
  "classParameters": {
    "visualSpanMeasures": 4,
    "routeDirection": "descending",
    "poseCycle": [
      "goat_rocky_descent_advance_01",
      "goat_rocky_descent_advance_02",
      "goat_rocky_descent_advance_03",
      "goat_rocky_descent_advance_04"
    ],
    "badNotePolicy": "Wobble",
    "measurePauseMs": 0,
    "showDestinationFromStart": true,
    "goodNoteBehavior": [
      "increment successful progress",
      "advance downward to next authored waypoint",
      "cycle descent pose",
      "orient/flip the static goat pose as needed to read as downhill movement",
      "show fx_rocky_descent_dust at hoof/rock contact",
      "show fx_rocky_descent_tick for Perfect, optionally smaller for Good"
    ],
    "badNoteBehavior": [
      "do not advance waypoint",
      "briefly wobble active goat pose and return to the same transform"
    ],
    "minigameCompleteBehavior": [
      "if passed, show goat_rocky_descent_finish at prop_rocky_descent_goal on the lower ledge",
      "otherwise freeze at furthest earned waypoint"
    ]
  },
  "assetBindings": {
    "background": [
      "bg_rocky_descent"
    ],
    "climberPoses": [
      "goat_rocky_descent_advance_01",
      "goat_rocky_descent_advance_02",
      "goat_rocky_descent_advance_03",
      "goat_rocky_descent_advance_04"
    ],
    "finishPose": [
      "goat_rocky_descent_finish"
    ],
    "waypointVisuals": [
      "prop_rocky_descent_step"
    ],
    "destinationVisual": [
      "prop_rocky_descent_goal"
    ],
    "stepEffects": [
      "fx_rocky_descent_dust",
      "fx_rocky_descent_tick"
    ]
  },
  "assets": [
    {
      "id": "bg_rocky_descent",
      "slot": "background",
      "type": "background",
      "placeholderSourceId": "karsiori_mountains",
      "sourceSelection": "Reuse the same mountain/background source family as Rocky Ascent, but compose the readable route from upper-left/upper-center toward the lower-right/lower-center.",
      "runtimeNotes": "Opaque. Static or simple parallax. Same art source can support all four levels; route coordinates carry the escalation."
    },
    {
      "id": "goat_rocky_descent_advance_01",
      "slot": "climberPoses[]",
      "type": "sprite",
      "placeholderSourceId": "spring_goat_ram",
      "sourceSelection": "Use frame 1 from goat or ram_strip5.png.",
      "runtimeNotes": "Transparent static billboard. Allow horizontal flip and small rotation to make the pose read downhill."
    },
    {
      "id": "goat_rocky_descent_advance_02",
      "slot": "climberPoses[]",
      "type": "sprite",
      "placeholderSourceId": "spring_goat_ram",
      "sourceSelection": "Use frame 2 from goat or ram_strip5.png.",
      "runtimeNotes": "Transparent static billboard. Reuse cyclically."
    },
    {
      "id": "goat_rocky_descent_advance_03",
      "slot": "climberPoses[]",
      "type": "sprite",
      "placeholderSourceId": "spring_goat_ram",
      "sourceSelection": "Use frame 3 from goat or ram_strip5.png.",
