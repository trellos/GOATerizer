{
  "$schema": "https://goaterizer.local/schema/scenario-v1.json",
  "id": "rocky_ascent",
  "displayName": "Rocky Ascent",
  "theme": "GOATS",
  "minigameClass": "ClimbMinigame",
  "family": "Scale",
  "visualVerb": "CLIMB",
  "supportedLevels": [
    1,
    2,
    3,
    4
  ],
  "scenarioPremise": "A goat climbs an orderly sequence of alpine boulders. Higher levels reuse the same small art library but author increasingly steep, exposed, and ridiculous waypoint paths.",
  "runTransposition": {
    "promptRepresentation": "diatonic_scale_degree",
    "degreeVocabulary": [
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "b1"
    ],
    "transposeToRunKey": true,
    "nonDiatonicTargetsAllowed": false,
    "note": "One octave, root to root. `b1` is the octave root above `1`; there is no second band."
  },
  "classParameters": {
    "visualSpanMeasures": 4,
    "poseCycle": [
      "goat_rocky_ascent_advance_01",
      "goat_rocky_ascent_advance_02",
      "goat_rocky_ascent_advance_03",
      "goat_rocky_ascent_advance_04"
    ],
    "badNotePolicy": "Wobble",
    "measurePauseMs": 0,
    "showDestinationFromStart": true,
    "goodNoteBehavior": [
      "increment successful progress",
      "advance to next authored waypoint",
      "cycle climber pose",
      "show fx_rocky_ascent_dust at contact point",
      "show fx_rocky_ascent_tick for Perfect, optionally smaller for Good"
    ],
    "badNoteBehavior": [
      "do not advance waypoint",
      "briefly wobble active goat pose and return to same transform"
    ],
    "minigameCompleteBehavior": [
      "if passed, show goat_rocky_ascent_finish at prop_rocky_ascent_goal",
      "otherwise freeze at furthest earned waypoint"
    ]
  },
  "assetBindings": {
    "background": [
      "bg_rocky_ascent"
    ],
    "climberPoses": [
      "goat_rocky_ascent_advance_01",
      "goat_rocky_ascent_advance_02",
      "goat_rocky_ascent_advance_03",
      "goat_rocky_ascent_advance_04"
    ],
    "finishPose": [
      "goat_rocky_ascent_finish"
    ],
    "destinationVisual": [
      "prop_rocky_ascent_goal"
    ],
    "stepEffects": [
      "fx_rocky_ascent_dust",
      "fx_rocky_ascent_tick"
    ],
    "footholdArt": {
      "body": [
        "note_rocky_ascent_ledge"
      ],
      "crag": [
        "note_rocky_ascent_crag"
      ]
    }
  },
  "assets": [
    {
      "id": "bg_rocky_ascent",
      "slot": "background",
      "type": "background",
      "placeholderSourceId": "karsiori_mountains",
      "sourceSelection": "Use one of the four 768x288 mountain background layers/compositions as the base. Leave the center-right ascent corridor readable.",
      "runtimeNotes": "Opaque. Static or simple parallax. Same source art can support all four levels; level escalation comes from waypoint authoring."
    },
    {
      "id": "goat_rocky_ascent_advance_01",
      "slot": "climberPoses[]",
      "type": "sprite",
      "placeholderSourceId": "spring_goat_ram",
      "sourceSelection": "Use frame 1 from goat or ram_strip5.png.",
      "runtimeNotes": "Transparent. Placeholder only; treat as one reusable climb pose."
    },
    {
      "id": "goat_rocky_ascent_advance_02",
      "slot": "climberPoses[]",
      "type": "sprite",
      "placeholderSourceId": "spring_goat_ram",
      "sourceSelection": "Use frame 2 from goat or ram_strip5.png.",
      "runtimeNotes": "Transparent. Reuse cyclically."
    },
    {
      "id": "goat_rocky_ascent_advance_03",
      "slot": "climberPoses[]",
      "type": "sprite",
      "placeholderSourceId": "spring_goat_ram",
      "sourceSelection": "Use frame 3 from goat or ram_strip5.png.",
      "runtimeNotes": "Transparent. Reuse cyclically."
    },
    {
      "id": "goat_rocky_ascent_advance_04",
      "slot": "climberPoses[]",
      "type": "sprite",
      "placeholderSourceId": "spring_goat_ram",
      "sourceSelection": "Use frame 4 from goat or ram_strip5.png.",
      "runtimeNotes": "Transparent. Reuse cyclically."
    },
    {
      "id": "goat_rocky_ascent_finish",
      "slot": "finishPose",
      "type": "sprite",
      "placeholderSourceId": "spring_goat_ram",
      "sourceSelection": "Use frame 5 from goat or ram_strip5.png.",
      "runtimeNotes": "Transparent. Place at summit cairn on successful completion."
    },
    {
      "id": "prop_rocky_ascent_step",
      "slot": "waypointVisuals[]",
      "type": "sprite",
      "placeholderSourceId": "karsiori_rock_piles",
      "sourceSelection": "Choose one small/medium silver, beige, or mossy pile; crop to transparent sprite.",
      "runtimeNotes": "Duplicate per waypoint; vary transform only."
    },
    {
      "id": "prop_rocky_ascent_goal",
      "slot": "destinationVisual",
      "type": "sprite",
      "placeholderSourceId": "karsiori_rock_piles",
      "sourceSelection": "Choose a taller stacked pile as a placeholder summit cairn.",
      "runtimeNotes": "Single persistent goal. Keep visually subordinate until the final approach."
    },
    {
      "id": "fx_rocky_ascent_dust",
      "slot": "stepEffects[]",
      "type": "sprite",
      "placeholderSourceId": "spring_dust",
      "sourceSelection": "Use one readable single frame from dusty.gif rather than the full animation.",
      "runtimeNotes": "Transparent. Pivot at lower center. Show briefly at hoof/rock contact."
    },
    {
      "id": "fx_rocky_ascent_tick",
      "slot": "stepEffects[]",
      "type": "sprite",
      "placeholderSourceId": "codemanu_pixel_fx",
      "sourceSelection": "Use a single small-hit / impact / star-like frame from the pack.",
      "runtimeNotes": "Transparent. Center pivot. Scale in/out for Perfect feedback."
    }
  ],
  "placeholderSources": {
    "karsiori_mountains": {
      "title": "FREE Pixel Art Mountains Tileset and Backgrounds",
      "author": "karsiori",
      "license": "CC0",
      "sourcePage": "https://karsiori.itch.io/free-pixel-art-mountains-tileset-and-backgrounds",
      "contains": [
        "4 x 768x288 background layers",
        "120 x 32x32 terrain tiles",
        "31 decorative elements"
      ],
      "attributionRequired": false,
      "selectionReason": "Good alpine palette and enough terrain/decor to block a readable rocky ascent."
    },
    "spring_goat_ram": {
      "title": "Pixel Art Enemies - Axe Throwing Goat or Ram...",
      "author": "Spring Spring",
      "license": "CC0 option available on source page",
      "sourcePage": "https://opengameart.org/content/pixel-art-enemies-axe-throwing-goat-or-ram-axe-throwing-monkey-or-ape-walking-pig",
      "file": "goat or ram_strip5.png",
      "attributionRequired": false,
      "selectionReason": "Tiny side-scrolling pixel goat/ram strip with five frames; enough to stand in for four climb poses plus finish."
    },
    "karsiori_rock_piles": {
      "title": "FREE Pixel Art Rock Pile Pack",
      "author": "karsiori",
      "license": "CC0",
      "sourcePage": "https://karsiori.itch.io/pixel-art-rock-pile-pack",
      "contains": [
        "15 rock piles",
        "2 sizes each",
        "6 color families"
      ],
      "attributionRequired": false,
      "selectionReason": "Enough reusable rock shapes for both footholds and a summit-cairn placeholder."
    },
    "spring_dust": {
      "title": "Dust Animation",
      "author": "Spring Spring",
      "license": "CC0",
      "sourcePage": "https://opengameart.org/content/dust-animation",
      "file": "dusty.gif",
      "attributionRequired": false,
      "selectionReason": "Tiny pixel dust effect; use only one frame to preserve GOATerizer's billboard constraint."
    },
    "codemanu_pixel_fx": {
      "title": "Free Pixel Effects Pack",
      "author": "CodeManu",
      "license": "CC0 / public domain",
      "sourcePage": "https://opengameart.org/content/free-pixel-effects-pack",
      "contains": [
        "20 pixel-art effects",
        "100x100 frames"
      ],
      "attributionRequired": false,
      "selectionReason": "Provides a cheap success glint/impact placeholder without requiring bespoke art."
    }
  },
  "productionNotes": [
    "Placeholder sources do not need to match perfectly in palette or pixel density; normalize nearest-neighbor scale and color treatment in the prototype.",
    "Do not animate the source strips/GIFs as traditional animation. Extract individual frames and treat them as independent static billboards.",
    "Rocky Ascent remains a precision/progress scene, not a danger scene; even L4 should read as absurd commitment rather than chase/survival.",
    "One successful note opportunity advances exactly one waypoint.",
    "The exercise is one octave, root to root. Higher levels climb it more times, faster \u2014 they do not climb higher."
  ],
  "designerReview": {
    "blockingIssues": [],
    "nonBlockingTBD": [
      "Star thresholds are authored but PROVISIONAL \u2014 see each level's `stars.note`.",
      "Phrases and (for Rocky Ascent) waypoint coordinates are regenerable via scripts/author-rocky-scenarios.mjs."
    ]
  },
